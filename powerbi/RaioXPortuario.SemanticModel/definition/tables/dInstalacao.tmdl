	partition dInstalacao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoDados & "dInstalacao.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    SemVazios = Table.TransformColumns(Cabecalhos, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"IDInstalacao", type text}, {"Instalacao", type text}, {"ComplexoPortuario", type text}, {"ComplexoPortuarioANTAQ", type text}, {"TipoInstalacao", type text}, {"Municipio", type text}, {"UF", type text}, {"UFNome", type text}, {"Regiao", type text}, {"Latitude", type number}, {"Longitude", type number}, {"PortoBenchmarkNE", type text}, {"EhSuape", Int64.Type}, {"OrdemBenchmark", Int64.Type}, {"GrupoBenchmark", type text}}, "en-US"),
				    Final = Table.AddColumn(Tipos, "LocalMapa", each [Municipio] & " - " & [UF] & ", Brasil", type text)
				in
				    Final

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

