	partition dNaturezaCarga = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoDados & "dNaturezaCarga.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    SemVazios = Table.TransformColumns(Cabecalhos, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"CodNatureza", Int64.Type}, {"NaturezaCarga", type text}, {"NaturezaCargaANTAQ", type text}, {"OrdemNatureza", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

