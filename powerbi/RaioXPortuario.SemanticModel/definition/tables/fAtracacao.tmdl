	partition fAtracacao = m
		mode: import
		source =
				let
				    Arquivos = Folder.Files(CaminhoDados & "fAtracacao"),
				    SoCsv = Table.SelectRows(Arquivos, each Text.StartsWith([Name], "fAtracacao_") and [Extension] = ".csv"),
				    Tabelas = List.Transform(SoCsv[Content], each Table.PromoteHeaders(Csv.Document(_, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])),
				    Combinado = Table.Combine(Tabelas),
				    SemVazios = Table.TransformColumns(Combinado, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"IDAtracacao", Int64.Type}, {"IDInstalacao", type text}, {"IDBerco", type text}, {"DataChegada", type datetime}, {"DataAtracacao", type datetime}, {"DataDesatracacao", type datetime}, {"CodNavegacao", Int64.Type}, {"CodNatureza", Int64.Type}, {"EsperaAtracacao_h", type number}, {"Operacao_h", type number}, {"Atracado_h", type number}, {"Estadia_h", type number}, {"Toneladas", type number}, {"TEU", type number}}, "en-US"),
				    Final = Table.AddColumn(Tipos, "DataRef", each Date.StartOfMonth(DateTime.Date([DataDesatracacao])), type date)
				in
				    Final

	annotation PBI_ResultType = Table

