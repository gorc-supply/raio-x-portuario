/// Tabela só de medidas, organizadas em pastas.
table _Medidas
	lineageTag: 4059890c-060c-57bb-a418-46fddf2102d7

	/// Toneladas movimentadas (peso bruto) — soma de VLPesoCargaBruta com FlagMCOperacaoCarga = 1 (regra ANTAQ).
	measure Toneladas = SUM ( fCarga[Toneladas] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: f4d06b7d-9618-594d-9da2-a70f8282adcb

	/// Toneladas do mesmo período do ano anterior, só nos meses que têm dado no período atual.
	measure 'Toneladas AA' =
			// meses do contexto atual que têm dado publicado
			VAR DatasComDado =
			    CALCULATETABLE ( VALUES ( dCalendario[Data] ), dCalendario[Mês com Dado] = TRUE () )
			RETURN
			    IF (
			        NOT ISEMPTY ( DatasComDado ),
			        CALCULATE ( [Toneladas], SAMEPERIODLASTYEAR ( DatasComDado ) )
			    )
		formatString: #,0
		displayFolder: Volume
		lineageTag: e4616186-23d2-5636-b266-00f32a51b65e

	/// Variação percentual das toneladas contra o mesmo período do ano anterior.
	measure 'Var % Toneladas AA' =
			VAR Atual = [Toneladas]
			VAR AnoAnterior = [Toneladas AA]
			RETURN
			    IF ( NOT ISBLANK ( AnoAnterior ), DIVIDE ( Atual - AnoAnterior, AnoAnterior ) )
		formatString: +0.0%;"−"0.0%;0.0%
		displayFolder: Volume
		lineageTag: 895612c7-aa05-588d-93bd-c06d3b8c709d

	/// Contêineres movimentados em TEU (unidade equivalente a um contêiner de 20 pés).
	measure TEU = SUM ( fCarga[TEU] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 2f12fca0-9a44-5c60-a3dc-5d0d7ae4d768

	/// Número de atracações com movimentação de carga no período (mês da desatracação).
	measure 'Nº Atracações' = COUNTROWS ( fAtracacao )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 70a3a019-84bd-5b32-bffa-b23ec03296c4

	/// Toneladas médias por atracação = soma das toneladas das atracações ÷ nº de atracações (razão de somas).
	measure 'Toneladas por Atracação' = DIVIDE ( SUM ( fAtracacao[Toneladas] ), [Nº Atracações] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 5bff60ac-0929-5def-84b1-924279658f43

	/// Participação das toneladas no total do Brasil do mesmo período (ignora filtros de instalação/região).
	measure '% do Total Brasil' = DIVIDE ( [Toneladas], CALCULATE ( [Toneladas], REMOVEFILTERS ( dInstalacao ) ) )
		formatString: 0.0%
		displayFolder: Participação
		lineageTag: 1d47007c-1ac7-52cc-92cc-a2ca50db1082

	/// Fatia das toneladas movimentada em navegação de cabotagem (entre portos brasileiros).
	measure '% Cabotagem' =
			DIVIDE (
			    CALCULATE ( [Toneladas], dNavegacao[Navegação] = "Cabotagem" ),
			    CALCULATE ( [Toneladas], REMOVEFILTERS ( dNavegacao ) )
			)
		formatString: 0.0%
		displayFolder: Participação
		lineageTag: a5c71b14-fbbb-5cfd-b0f3-75fa91007c6b

	/// Fatia das toneladas movimentada em navegação de longo curso (comércio exterior).
	measure '% Longo Curso' =
			DIVIDE (
			    CALCULATE ( [Toneladas], dNavegacao[Navegação] = "Longo Curso" ),
			    CALCULATE ( [Toneladas], REMOVEFILTERS ( dNavegacao ) )
			)
		formatString: 0.0%
		displayFolder: Participação
		lineageTag: 99a25b8d-041f-55db-b2a2-7469881dee8c

	/// Fatia das toneladas movimentada em contêiner (0% quando o porto não movimenta contêiner).
	measure '% Contêiner' =
			IF (
			    NOT ISBLANK ( [Toneladas] ),
			    DIVIDE (
			        CALCULATE ( [Toneladas], dNaturezaCarga[Natureza da Carga] = "Contêiner" ),
			        CALCULATE ( [Toneladas], REMOVEFILTERS ( dNaturezaCarga ) )
			    ) + 0
			)
		formatString: 0.0%
		displayFolder: Participação
		lineageTag: ebc61e8a-28ab-54fc-ba32-2196ce970a62

	/// Posição por toneladas entre as instalações (ou complexos) visíveis no visual — 1 = maior.
	measure 'Ranking Porto' =
			VAR T = [Toneladas]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( T ), BLANK (),
			        // a coluna Porto é ordenada por OrdemBenchmark: o visual agrupa pelas duas, então o RANKX itera o par
			        ISINSCOPE ( dInstalacao[Porto (benchmark NE)] ),
			            RANKX (
			                ALLSELECTED ( dInstalacao[Porto (benchmark NE)], dInstalacao[OrdemBenchmark] ),
			                [Toneladas], , DESC, DENSE
			            ),
			        ISINSCOPE ( dInstalacao[Instalação] ),
			            RANKX ( ALLSELECTED ( dInstalacao[Instalação] ), [Toneladas], , DESC, DENSE ),
			        ISINSCOPE ( dInstalacao[Complexo Portuário] ),
			            RANKX ( ALLSELECTED ( dInstalacao[Complexo Portuário] ), [Toneladas], , DESC, DENSE )
			    )
		formatString: #,0
		displayFolder: Participação
		lineageTag: fc74433f-cd9c-5b77-81db-cbfe1715d1e3

	/// Posição de Suape entre todas as instalações do Brasil por toneladas no período.
	measure 'Ranking Suape Brasil' =
			VAR ToneladasSuape =
			    CALCULATE ( [Toneladas], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 )
			VAR Todas =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dInstalacao[Instalação] ), "@t", [Toneladas] ),
			        REMOVEFILTERS ( dInstalacao )
			    )
			RETURN
			    IF ( NOT ISBLANK ( ToneladasSuape ), COUNTROWS ( FILTER ( Todas, [@t] > ToneladasSuape ) ) + 1 )
		formatString: #,0
		displayFolder: Participação
		lineageTag: 480e69ef-e222-554c-a594-ff762e673965

	/// Média das horas entre a chegada do navio e a atracação. Sensível a filas longas.
	measure 'Espera Média (h)' = AVERAGE ( fAtracacao[EsperaAtracacao_h] )
		formatString: #,0.0" h"
		displayFolder: Eficiência
		lineageTag: 54eb71d1-e55a-5d84-becb-fe6767bebb8b

	/// Mediana das horas entre chegada e atracação: a espera do navio típico, sem distorção das filas extremas.
	measure 'Espera Mediana (h)' = MEDIAN ( fAtracacao[EsperaAtracacao_h] )
		formatString: #,0.0" h"
		displayFolder: Eficiência
		lineageTag: d26e48a9-f74c-50c5-914b-9f7b6f545b1c

	/// Média das horas entre atracação e desatracação (ocupação do berço por navio).
	measure 'Tempo Atracado Médio (h)' = AVERAGE ( fAtracacao[Atracado_h] )
		formatString: #,0.0" h"
		displayFolder: Eficiência
		lineageTag: a82ae17a-2094-51bb-84b9-2b2910358950

	/// Média das horas entre o início e o fim da operação de carga/descarga.
	measure 'Tempo de Operação Médio (h)' = AVERAGE ( fAtracacao[Operacao_h] )
		formatString: #,0.0" h"
		displayFolder: Eficiência
		lineageTag: 97941b91-846a-5fca-910a-15c43c15612f

	/// Horas de operação ÷ horas atracado (só atracações com os dois tempos): quanto do tempo no berço é operação.
	measure '% Atracado em Operação' =
			VAR HorasOperacao =
			    CALCULATE (
			        SUM ( fAtracacao[Operacao_h] ),
			        KEEPFILTERS ( NOT ISBLANK ( fAtracacao[Operacao_h] ) ),
			        KEEPFILTERS ( NOT ISBLANK ( fAtracacao[Atracado_h] ) )
			    )
			VAR HorasAtracado =
			    CALCULATE (
			        SUM ( fAtracacao[Atracado_h] ),
			        KEEPFILTERS ( NOT ISBLANK ( fAtracacao[Operacao_h] ) ),
			        KEEPFILTERS ( NOT ISBLANK ( fAtracacao[Atracado_h] ) )
			    )
			RETURN
			    DIVIDE ( HorasOperacao, HorasAtracado )
		formatString: 0.0%
		displayFolder: Eficiência
		lineageTag: 313ef974-a0d4-5854-b317-87a12da74b01

	/// Toneladas ÷ horas de operação (razão de somas, só atracações com tempo de operação > 0).
	measure 'Prancha Média Operacional (t/h)' =
			DIVIDE (
			    CALCULATE ( SUM ( fAtracacao[Toneladas] ), KEEPFILTERS ( fAtracacao[Operacao_h] > 0 ) ),
			    CALCULATE ( SUM ( fAtracacao[Operacao_h] ), KEEPFILTERS ( fAtracacao[Operacao_h] > 0 ) )
			)
		formatString: #,0" t/h"
		displayFolder: Eficiência
		lineageTag: c1be96d0-574f-5e69-9128-be9e61163337

	/// Toneladas ÷ horas atracado (razão de somas): produtividade considerando todo o tempo no berço.
	measure 'Prancha Média Geral (t/h)' =
			DIVIDE (
			    CALCULATE ( SUM ( fAtracacao[Toneladas] ), KEEPFILTERS ( fAtracacao[Atracado_h] > 0 ) ),
			    CALCULATE ( SUM ( fAtracacao[Atracado_h] ), KEEPFILTERS ( fAtracacao[Atracado_h] > 0 ) )
			)
		formatString: #,0" t/h"
		displayFolder: Eficiência
		lineageTag: cdce4cda-966d-5a0d-851b-4afa21a49509

	/// Soma das horas de paralisação registradas durante as atracações (chuva, quebra, espera de carga etc.).
	measure 'Horas Paralisadas' = SUM ( fParalisacao[HorasParalisadas] )
		formatString: #,0" h"
		displayFolder: Eficiência
		lineageTag: 37c1d236-05e3-590f-a7d9-ae22e41dfc87

	/// Espera mediana de Suape no período, independentemente do porto filtrado.
	measure 'Espera Mediana Suape (h)' = CALCULATE ( [Espera Mediana (h)], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 )
		formatString: #,0.0" h"
		displayFolder: Eficiência\Benchmark Nordeste
		lineageTag: d88757e3-58e3-5e46-9f41-d9cd669f5093

	/// Média simples das esperas medianas dos 8 pares do Nordeste (Pecém, Itaqui, Salvador, Aratu, Recife, Natal, Cabedelo, Maceió).
	measure 'Espera Mediana Média Pares (h)' =
			VAR Pares =
			    CALCULATETABLE (
			        VALUES ( dInstalacao[Porto (benchmark NE)] ),
			        REMOVEFILTERS ( dInstalacao ),
			        dInstalacao[Grupo do Benchmark] = "Pares do Nordeste"
			    )
			RETURN
			    AVERAGEX (
			        Pares,
			        VAR Porto = dInstalacao[Porto (benchmark NE)]
			        RETURN
			            CALCULATE (
			                [Espera Mediana (h)],
			                REMOVEFILTERS ( dInstalacao ),
			                dInstalacao[Porto (benchmark NE)] = Porto
			            )
			    )
		formatString: #,0.0" h"
		displayFolder: Eficiência\Benchmark Nordeste
		lineageTag: 915e10f4-688d-5438-9659-afe738df911b

	/// Espera mediana de Suape menos a média dos pares (negativo = Suape espera menos).
	measure 'Diferença Espera Suape vs Pares (h)' = [Espera Mediana Suape (h)] - [Espera Mediana Média Pares (h)]
		formatString: +#,0.0" h";"−"#,0.0" h";0.0" h"
		displayFolder: Eficiência\Benchmark Nordeste
		lineageTag: 5cc59285-3d3a-5629-bf2c-d8d1cc381343

	/// Toneladas de Suape no período.
	measure 'Toneladas Suape' = CALCULATE ( [Toneladas], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 )
		formatString: #,0
		displayFolder: Volume\Suape
		lineageTag: a2fe248b-31e1-54e9-be00-8d3c666676e4

	/// TEU movimentados em Suape no período.
	measure 'TEU Suape' = CALCULATE ( [TEU], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 )
		formatString: #,0
		displayFolder: Volume\Suape
		lineageTag: bb02482d-a450-550e-9089-54389f06c3cd

	/// Variação de toneladas de Suape vs. ano anterior.
	measure 'Var % Toneladas Suape AA' = CALCULATE ( [Var % Toneladas AA], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 )
		formatString: +0.0%;"−"0.0%;0.0%
		displayFolder: Volume\Suape
		lineageTag: bd9bcdfd-e386-5357-84cb-41444561fb8e

	/// Fatia de contêiner nas toneladas de Suape.
	measure '% Contêiner Suape' = CALCULATE ( [% Contêiner], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 )
		formatString: 0.0%
		displayFolder: Participação
		lineageTag: f2e010fe-a6ac-5e05-b2c4-79b58d5c6b62

	/// Texto com o recorte e a data de processamento do pipeline.
	measure 'Última Atualização' =
			"Dados ANTAQ 2021–2025 (anos completos) · processado em "
			    & FORMAT ( MAX ( Meta[Data de Processamento] ), "dd/mm/yyyy" )
		displayFolder: Auxiliares
		lineageTag: a795f4cb-0a21-5ab8-b464-0e1479106615

	/// Texto do período filtrado (ex.: 'em 2025', 'de 2021 a 2025').
	measure 'Título Dinâmico Período' =
			VAR DataIni = CALCULATE ( MIN ( dCalendario[Data] ), dCalendario[Mês com Dado] = TRUE () )
			VAR DataFim = CALCULATE ( MAX ( dCalendario[Data] ), dCalendario[Mês com Dado] = TRUE () )
			VAR AnoIni = YEAR ( DataIni )
			VAR AnoFim = YEAR ( DataFim )
			VAR AnoCompleto = MONTH ( DataIni ) = 1 && MONTH ( DataFim ) = 12
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DataIni ), "no período sem dados",
			        AnoIni = AnoFim && AnoCompleto, "em " & AnoIni,
			        AnoIni = AnoFim && MONTH ( DataIni ) = MONTH ( DataFim ), "em " & FORMAT ( DataFim, "mmm/yyyy" ),
			        AnoIni = AnoFim, "de " & FORMAT ( DataIni, "mmm" ) & " a " & FORMAT ( DataFim, "mmm/yyyy" ),
			        "de " & AnoIni & " a " & AnoFim
			    )
		displayFolder: Auxiliares
		lineageTag: 17189bcd-f83d-5039-b1c5-fa158b6b2b8c

	/// Cor das barras/pontos: dourado para Suape (ou o complexo que contém Suape), azul para as demais.
	measure 'Cor Destaque Suape' = IF ( MAX ( dInstalacao[EhSuape] ) = 1, "#C9A96E", "#8FB4D9" )
		displayFolder: Auxiliares
		lineageTag: 89b41581-df55-5961-aa1b-6c60ab0a1919

	/// Cor do texto: dourado na linha de Suape, branco nas demais.
	measure 'Cor Texto Suape' = IF ( MAX ( dInstalacao[EhSuape] ) = 1, "#C9A96E", "#FFFFFF" )
		displayFolder: Auxiliares
		lineageTag: 817181a9-400b-5cfd-8a61-6b3943da338d

	/// Cor do mapa de calor da espera mediana: até 2 h, 6 h, 24 h, 72 h e acima de 72 h.
	measure 'Cor Calor Espera' =
			VAR Espera = [Espera Mediana (h)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Espera ), BLANK (),
			        Espera <= 2, "#1E3A2F",
			        Espera <= 6, "#2F5D46",
			        Espera <= 24, "#6E5F33",
			        Espera <= 72, "#8F4A28",
			        "#7A1C2A"
			    )
		displayFolder: Auxiliares
		lineageTag: 83afb9e6-7c4c-5219-b349-6aaf6ad6da1b

	/// Verde se a espera mediana do porto é menor ou igual à média dos pares; vermelho se maior.
	measure 'Cor Benchmark Espera' =
			VAR Espera = [Espera Mediana (h)]
			RETURN
			    IF (
			        NOT ISBLANK ( Espera ),
			        IF ( Espera <= [Espera Mediana Média Pares (h)], "#1E3A2F", "#5A2318" )
			    )
		displayFolder: Auxiliares
		lineageTag: 8b49111f-631d-5309-bcec-0f7da348a3af

	/// Manchete da página Visão Geral.
	measure 'Título KPI Brasil' =
			VAR Mt = [Toneladas] / 1000000
			VAR Variacao = [Var % Toneladas AA]
			RETURN
			    "Portos brasileiros movimentaram " & FORMAT ( Mt, "#,0.0" ) & " Mi t " & [Título Dinâmico Período]
			        & IF (
			            NOT ISBLANK ( Variacao ),
			            " (" & IF ( Variacao >= 0, "+", "−" ) & FORMAT ( ABS ( Variacao ), "0.0%" ) & " vs. ano anterior)"
			        )
		displayFolder: Auxiliares\Títulos
		lineageTag: 91c4be33-400c-5ce3-8a85-93b23b0dce53

	/// Título do gráfico de linha mensal.
	measure 'Título Linha Mensal' = "Toneladas por mês " & [Título Dinâmico Período] & " (cinza = ano anterior)"
		displayFolder: Auxiliares\Títulos
		lineageTag: f699e08e-3eff-5e1d-8292-6755d94c63eb

	/// Título do gráfico por região.
	measure 'Título Região' =
			VAR Lider =
			    TOPN ( 1, ADDCOLUMNS ( VALUES ( dInstalacao[Região] ), "@t", [Toneladas] ), [@t], DESC )
			RETURN
			    MAXX ( Lider, dInstalacao[Região] ) & " concentra " & FORMAT ( DIVIDE ( MAXX ( Lider, [@t] ), [Toneladas] ), "0%" )
			        & " da carga"
		displayFolder: Auxiliares\Títulos
		lineageTag: 61b7a2ed-1209-5ec7-99b1-79bd8443fca7

	/// Título do ranking de instalações.
	measure 'Título Top 10' =
			VAR Lider =
			    TOPN ( 1, ADDCOLUMNS ( VALUES ( dInstalacao[Instalação] ), "@t", [Toneladas] ), [@t], DESC )
			RETURN
			    "Top 10 instalações: " & MAXX ( Lider, dInstalacao[Instalação] ) & " lidera com "
			        & FORMAT ( MAXX ( Lider, [@t] ) / 1000000, "#,0.0" ) & " Mi t " & [Título Dinâmico Período]
		displayFolder: Auxiliares\Títulos
		lineageTag: f47bcf9a-e06d-53fa-9c53-64093b15c70c

	/// Manchete da página Nordeste & Suape: espera de Suape vs. pares.
	measure 'Título Benchmark Espera' =
			VAR Dif = [Diferença Espera Suape vs Pares (h)]
			RETURN
			    IF (
			        ISBLANK ( Dif ), "Espera mediana: Suape x média dos pares",
			        "Suape opera com espera mediana " & FORMAT ( ABS ( Dif ), "#,0.0" ) & " h "
			            & IF ( Dif <= 0, "menor", "maior" ) & " que a média dos pares " & [Título Dinâmico Período]
			    )
		displayFolder: Auxiliares\Títulos
		lineageTag: 87425e10-9da6-528f-bca4-91adc26f85a0

	/// Título das barras de crescimento.
	measure 'Título Crescimento Pares' =
			VAR Pares =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dInstalacao[Porto (benchmark NE)] ), "@v", [Var % Toneladas AA] ),
			        NOT ISBLANK ( dInstalacao[Porto (benchmark NE)] )
			    )
			VAR Lider = TOPN ( 1, FILTER ( Pares, NOT ISBLANK ( [@v] ) ), [@v], DESC )
			VAR v = MAXX ( Lider, [@v] )
			RETURN
			    IF (
			        ISEMPTY ( Lider ), "Crescimento vs. ano anterior",
			        "Maior alta " & [Título Dinâmico Período] & ": " & MAXX ( Lider, dInstalacao[Porto (benchmark NE)] )
			            & " (" & IF ( v >= 0, "+", "−" ) & FORMAT ( ABS ( v ), "0.0%" ) & ")"
			    )
		displayFolder: Auxiliares\Títulos
		lineageTag: cfa66947-3764-5450-b28d-377e0df6ad4a

	/// Título do mapa de calor.
	measure 'Título Mapa de Calor' =
			VAR Lider =
			    TOPN (
			        1,
			        CALCULATETABLE (
			            ADDCOLUMNS ( VALUES ( dInstalacao[Porto (benchmark NE)] ), "@e", [Espera Mediana (h)] ),
			            NOT ISBLANK ( dInstalacao[Porto (benchmark NE)] )
			        ),
			        [@e], DESC
			    )
			RETURN
			    "Espera mediana (h) por mês " & [Título Dinâmico Período] & " · maior: " & MAXX ( Lider, dInstalacao[Porto (benchmark NE)] )
			        & " (" & FORMAT ( MAXX ( Lider, [@e] ), "#,0" ) & " h)"
		displayFolder: Auxiliares\Títulos
		lineageTag: 22eba196-f214-50bb-afc0-d3c10eeb29bf

	/// Título das barras de % atracado em operação.
	measure 'Título Operação' =
			"Suape opera " & FORMAT ( CALCULATE ( [% Atracado em Operação], REMOVEFILTERS ( dInstalacao ), dInstalacao[EhSuape] = 1 ), "0%" )
			    & " do tempo atracado " & [Título Dinâmico Período]
		displayFolder: Auxiliares\Títulos
		lineageTag: 8de51d95-6b74-53a4-aab1-44a8856ad86c

	/// Título das horas paralisadas por motivo.
	measure 'Título Paralisação' =
			VAR Lider =
			    TOPN ( 1, ADDCOLUMNS ( VALUES ( fParalisacao[Motivo da Paralisação] ), "@h", [Horas Paralisadas] ), [@h], DESC )
			RETURN
			    IF (
			        ISEMPTY ( Lider ), "Horas paralisadas por motivo",
			        "Top 8 motivos de paralisação · maior: " & MAXX ( Lider, fParalisacao[Motivo da Paralisação] ) & " ("
			            & FORMAT ( DIVIDE ( MAXX ( Lider, [@h] ), [Horas Paralisadas] ), "0%" ) & ")"
			    )
		displayFolder: Auxiliares\Títulos
		lineageTag: 3f22b3d0-4df8-526c-9e8d-c439aaeead8d

	/// Título da dispersão espera x prancha.
	measure 'Título Dispersão' = "Portos públicos " & [Título Dinâmico Período] & ": espera (h) x prancha (t/h)"
		displayFolder: Auxiliares\Títulos
		lineageTag: dac74095-0172-5468-850a-9df11ee0b571

	/// Título da composição por natureza de carga.
	measure 'Título Natureza' =
			VAR Lider =
			    TOPN ( 1, ADDCOLUMNS ( VALUES ( dNaturezaCarga[Natureza da Carga] ), "@t", [Toneladas] ), [@t], DESC )
			RETURN
			    "Por mês · " & MAXX ( Lider, dNaturezaCarga[Natureza da Carga] ) & " responde por "
			        & FORMAT ( DIVIDE ( MAXX ( Lider, [@t] ), [Toneladas] ), "0%" ) & " da carga"
		displayFolder: Auxiliares\Títulos
		lineageTag: 63f10294-a6dd-590f-a5af-f56ec6382d8a

	/// Título do top mercadorias.
	measure 'Título Mercadorias' =
			VAR Lider =
			    TOPN ( 1, ADDCOLUMNS ( VALUES ( dMercadoria[Mercadoria] ), "@t", [Toneladas] ), [@t], DESC )
			RETURN
			    "Top 10 mercadorias · " & MAXX ( Lider, dMercadoria[Mercadoria] ) & ": "
			        & FORMAT ( DIVIDE ( MAXX ( Lider, [@t] ), [Toneladas] ), "0%" ) & " das toneladas"
		displayFolder: Auxiliares\Títulos
		lineageTag: d4d018da-1d66-5617-90d0-f9fbda095920

	/// Título do embarque x desembarque.
	measure 'Título Sentido' =
			VAR Emb = CALCULATE ( [Toneladas], dSentido[Sentido] = "Embarque" )
			RETURN
			    FORMAT ( DIVIDE ( Emb, CALCULATE ( [Toneladas], REMOVEFILTERS ( dSentido ) ) ), "0%" ) & " das toneladas são embarque"
		displayFolder: Auxiliares\Títulos
		lineageTag: 83782753-f387-5db3-a8d1-4d9fbdcc8c04

	/// Título da movimentação por navegação.
	measure 'Título Navegação' = "Por navegação · longo curso " & FORMAT ( [% Longo Curso], "0%" ) & ", cabotagem " & FORMAT ( [% Cabotagem], "0%" )
		displayFolder: Auxiliares\Títulos
		lineageTag: dc0555a8-a8af-5aaf-94c1-8e87db499a99

	/// Toneladas em milhões, para eixos e rótulos de gráfico.
	measure 'Toneladas (Mi t)' = DIVIDE ( [Toneladas], 1000000 )
		formatString: #,0.0" Mi t"
		displayFolder: Volume
		lineageTag: a5318de6-d57f-5baa-801b-806bab79b82e

	/// Toneladas do ano anterior em milhões.
	measure 'Toneladas AA (Mi t)' = DIVIDE ( [Toneladas AA], 1000000 )
		formatString: #,0.0" Mi t"
		displayFolder: Volume
		lineageTag: 5519f9c1-4eb0-5eaf-999f-98a3cd077ae5

	/// Latitude do complexo portuário (média das coordenadas oficiais ponderada por toneladas).
	measure 'Latitude do Complexo' = MAX ( dInstalacao[Latitude do Complexo] )
		formatString: 0.000
		displayFolder: Auxiliares\Mapa
		lineageTag: a4c3710d-ebdc-5106-9412-cdcef9c96661

	/// Longitude do complexo portuário (média das coordenadas oficiais ponderada por toneladas).
	measure 'Longitude do Complexo' = MAX ( dInstalacao[Longitude do Complexo] )
		formatString: 0.000
		displayFolder: Auxiliares\Mapa
		lineageTag: 160e91bf-b184-5981-932f-74320358b3f0

	/// 1 para Suape e para os 5 complexos com mais toneladas no contexto (os que recebem rótulo no mapa).
	measure 'Destaque no Mapa' =
			VAR Posicao =
			    IF (
			        ISINSCOPE ( dInstalacao[Complexo Portuário] ),
			        RANKX ( ALLSELECTED ( dInstalacao[Complexo Portuário] ), [Toneladas], , DESC, DENSE )
			    )
			RETURN
			    IF ( NOT ISBLANK ( [Toneladas] ) && ( Posicao <= 5 || MAX ( dInstalacao[EhSuape] ) = 1 ), 1 )
		formatString: #,0
		displayFolder: Auxiliares\Mapa
		lineageTag: 83dfa92f-a6b1-51f2-82c3-48e9aeb2dbbd

	/// Latitude só dos complexos destacados (camada de rótulos).
	measure 'Latitude (rótulo)' = IF ( [Destaque no Mapa] = 1, MAX ( dInstalacao[Latitude do Rótulo] ) )
		formatString: 0.000
		displayFolder: Auxiliares\Mapa
		lineageTag: 5c4255fa-6db2-58b9-8fe1-19809b83b0bc

	/// Longitude só dos complexos destacados (camada de rótulos).
	measure 'Longitude (rótulo)' = IF ( [Destaque no Mapa] = 1, MAX ( dInstalacao[Longitude do Rótulo] ) )
		formatString: 0.000
		displayFolder: Auxiliares\Mapa
		lineageTag: d96d3684-bb75-574d-9964-148c278cdd13

	/// UF(s) do complexo portuário (dica de ferramenta).
	measure 'UF do Complexo' = CONCATENATEX ( VALUES ( dInstalacao[UF] ), dInstalacao[UF], "/" )
		displayFolder: Auxiliares\Mapa
		lineageTag: e638b62a-33c9-5676-bcdf-e3ce09e3cd4f

	/// Toneladas em milhões com unidade (cartão).
	measure 'Rótulo Toneladas' =
			VAR v = [Toneladas (Mi t)]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0.0" ) & " Mi t" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: d92198c2-b2f6-5376-b84a-204e3c6c35eb

	/// Variação vs. ano anterior com sinal (cartão).
	measure 'Rótulo Var % AA' =
			VAR v = [Var % Toneladas AA]
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        IF ( v >= 0, "+", "−" ) & FORMAT ( ABS ( v ), "0.0%" )
			    )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 2da5f334-69f2-5527-85cc-a189ce9a0bf4

	/// Nº de atracações com separador de milhar (cartão).
	measure 'Rótulo Atracações' =
			VAR v = [Nº Atracações]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0" ) )
		displayFolder: Auxiliares\Rótulos
		lineageTag: dc6f6ed9-a2fa-55a4-9859-7654876a26b5

	/// Espera mediana com 1 casa e unidade (cartão).
	measure 'Rótulo Espera Mediana' =
			VAR v = [Espera Mediana (h)]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0.0" ) & " h" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: d1556c91-0060-5c92-9059-4042e4c36e1a

	/// Prancha operacional inteira com unidade (cartão).
	measure 'Rótulo Prancha Operacional' =
			VAR v = [Prancha Média Operacional (t/h)]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0" ) & " t/h" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: da1bd3b5-c7d5-570a-85a0-f78d6aa22f19

	/// Tempo atracado médio (cartão).
	measure 'Rótulo Tempo Atracado' =
			VAR v = [Tempo Atracado Médio (h)]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0.0" ) & " h" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 5cb63360-d65d-5afe-8f8b-84c6b31d37ac

	/// % do tempo atracado em operação (cartão).
	measure 'Rótulo % Atracado em Operação' =
			VAR v = [% Atracado em Operação]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0%" ) )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 23a423f4-9437-5fb7-9e87-943b933bd463

	/// Horas paralisadas em milhares (cartão).
	measure 'Rótulo Horas Paralisadas' =
			VAR v = DIVIDE ( [Horas Paralisadas], 1000 )
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0.0" ) & " mil h" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 42932356-613a-5e3e-9e6c-d24a46700b56

	/// TEU em milhares (cartão).
	measure 'Rótulo TEU' =
			VAR v = DIVIDE ( [TEU], 1000 )
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0" ) & " mil TEU" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 40858211-7741-5c43-bbf0-72a74dba86eb

	/// % contêiner (cartão).
	measure 'Rótulo % Contêiner' =
			VAR v = [% Contêiner]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0%" ) )
		displayFolder: Auxiliares\Rótulos
		lineageTag: f5ef2b8b-5e0c-51b1-8cba-f4817262eb64

	/// % longo curso (cartão).
	measure 'Rótulo % Longo Curso' =
			VAR v = [% Longo Curso]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0%" ) )
		displayFolder: Auxiliares\Rótulos
		lineageTag: df7eb34f-6d09-5553-93ce-81e6ff7bded2

	/// % cabotagem (cartão).
	measure 'Rótulo % Cabotagem' =
			VAR v = [% Cabotagem]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0%" ) )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 90467ab4-88e1-5bfa-9825-7b764f97c890

	/// Toneladas de Suape em milhões (cartão).
	measure 'Rótulo Toneladas Suape' =
			VAR v = DIVIDE ( [Toneladas Suape], 1000000 )
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0.0" ) & " Mi t" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: f496f272-b5ea-5155-a6a1-0f1b9d14d458

	/// Variação de Suape vs. ano anterior (cartão).
	measure 'Rótulo Var % Suape' =
			VAR v = [Var % Toneladas Suape AA]
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        IF ( v >= 0, "+", "−" ) & FORMAT ( ABS ( v ), "0.0%" )
			    )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 459dbcf3-8a20-5935-a218-e9bc42a782f3

	/// TEU de Suape em milhares (cartão).
	measure 'Rótulo TEU Suape' =
			VAR v = DIVIDE ( [TEU Suape], 1000 )
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0" ) & " mil TEU" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: b3b08933-3019-583a-852d-92151692b8c3

	/// % contêiner de Suape (cartão).
	measure 'Rótulo % Contêiner Suape' =
			VAR v = [% Contêiner Suape]
			RETURN
			    IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0%" ) )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 0a5d1d4d-cac4-5f33-a6cc-d0eb465683e6

	/// Posição de Suape no Brasil (cartão).
	measure 'Rótulo Ranking Suape' =
			VAR r = [Ranking Suape Brasil]
			RETURN
			    IF ( NOT ISBLANK ( r ), r & "ª do Brasil" )
		displayFolder: Auxiliares\Rótulos
		lineageTag: 76b048bb-c439-575a-b889-1661cdbacef0

	/// Toneladas (Mi t) só das 10 maiores instalações visíveis (ranking sem barra de rolagem).
	measure 'Toneladas (Top 10) (Mi t)' = IF ( [Ranking Porto] <= 10, [Toneladas (Mi t)] )
		formatString: #,0.0" Mi t"
		displayFolder: Auxiliares
		lineageTag: f5ea5b38-2814-5687-b3d1-d32607885810

	/// Toneladas (Mi t) só das 10 maiores mercadorias visíveis.
	measure 'Toneladas (Top 10 mercadorias) (Mi t)' =
			VAR Posicao =
			    IF (
			        ISINSCOPE ( dMercadoria[Mercadoria] ),
			        RANKX ( ALLSELECTED ( dMercadoria[Mercadoria] ), [Toneladas], , DESC, DENSE )
			    )
			RETURN
			    IF ( Posicao <= 10, [Toneladas (Mi t)] )
		formatString: #,0.0" Mi t"
		displayFolder: Auxiliares
		lineageTag: 56dc38df-b2b4-5232-9ce2-d90855fc2c1b

	/// Título do mapa.
	measure 'Título Mapa' = "Complexos portuários " & [Título Dinâmico Período] & " (tamanho = toneladas)"
		displayFolder: Auxiliares\Títulos
		lineageTag: d019db4f-c2ed-53aa-b779-6dee89a458fd

	/// Título da tabela de benchmark.
	measure 'Título Tabela Benchmark' = "Suape x pares " & [Título Dinâmico Período] & " · verde = espera mediana até a média dos pares"
		displayFolder: Auxiliares\Títulos
		lineageTag: 80a6a05a-8009-5393-af43-89659972f008

	/// Título da linha Suape x pares.
	measure 'Título Linha Suape Pares' = "Espera mediana por mês " & [Título Dinâmico Período] & ": Suape (dourado) x média dos pares (cinza)"
		displayFolder: Auxiliares\Títulos
		lineageTag: f10294b2-0f01-57d2-b91a-c7e2b7644721

	/// Manchete da página Eficiência e Gargalos.
	measure 'Título Eficiência' =
			"Navio típico esperou " & FORMAT ( [Espera Mediana (h)], "#,0.0" ) & " h para atracar " & [Título Dinâmico Período]
			    & "; prancha operacional de " & FORMAT ( [Prancha Média Operacional (t/h)], "#,0" ) & " t/h"
		displayFolder: Auxiliares\Títulos
		lineageTag: 5ac9cd5f-880d-5503-a66f-cafa26ab45d7

	/// Manchete da página Perfil de Carga.
	measure 'Título Perfil' =
			VAR Selecao =
			    IF (
			        HASONEVALUE ( dInstalacao[Instalação] ), SELECTEDVALUE ( dInstalacao[Instalação] ),
			        IF ( ISFILTERED ( dInstalacao ), "Instalações selecionadas", "Brasil" )
			    )
			RETURN
			    Selecao & " " & [Título Dinâmico Período] & ": " & FORMAT ( [Toneladas] / 1000000, "#,0.0" ) & " Mi t movimentadas"
		displayFolder: Auxiliares\Títulos
		lineageTag: 3b15246d-b24f-57c5-a8a7-19b320433d71

	/// Horas paralisadas só dos 8 motivos com mais horas no contexto (cabe sem rolagem em qualquer zoom).
	measure 'Horas Paralisadas (Top 8 motivos)' =
			VAR Posicao =
			    IF (
			        ISINSCOPE ( fParalisacao[Motivo da Paralisação] ),
			        RANKX ( ALLSELECTED ( fParalisacao[Motivo da Paralisação] ), [Horas Paralisadas], , DESC, DENSE )
			    )
			RETURN
			    IF ( Posicao <= 8, [Horas Paralisadas] )
		formatString: #,0" h"
		displayFolder: Auxiliares
		lineageTag: 7d155520-9910-5e09-b741-ea5a81fc879a

	column Medidas
		dataType: string
		isHidden
		lineageTag: 1b802c51-80ba-559b-af2c-b1a026770965
