/// Mercadorias: SH4 com descrição oficial do Comex Stat (MDIC), nome curto e grupo simplificado do projeto.
table dMercadoria
	lineageTag: b83383f0-a5a7-561b-a131-ac882d7eeded

	column CodMercadoria
		dataType: string
		isHidden
		lineageTag: 9d6b1169-926c-500a-bed4-61a59d99c48c
		summarizeBy: none
		sourceColumn: CodMercadoria

		annotation SummarizationSetBy = Automatic

	column Mercadoria
		dataType: string
		lineageTag: 539dbf8e-1ce0-5a81-92bd-544d3c9b1d52
		summarizeBy: none
		sourceColumn: Mercadoria

		annotation SummarizationSetBy = Automatic

	column DescricaoSH4
		dataType: string
		lineageTag: 6e71adfa-dd1e-52ec-af89-d913f6182a61
		summarizeBy: none
		sourceColumn: DescricaoSH4

		annotation SummarizationSetBy = Automatic

	column CapituloSH2
		dataType: string
		lineageTag: 35e2fa2c-8642-5405-a01f-a5da8adfe0d8
		summarizeBy: none
		sourceColumn: CapituloSH2

		annotation SummarizationSetBy = Automatic

	column DescricaoCapituloSH2
		dataType: string
		lineageTag: c75a97e6-5204-5e77-a241-4ab2211ea90b
