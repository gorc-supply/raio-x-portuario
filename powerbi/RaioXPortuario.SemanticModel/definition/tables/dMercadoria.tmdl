	column FonteDescricao
		dataType: string
		lineageTag: 2634fcf6-4252-5b63-a8d6-0d26964f94d7
		summarizeBy: none
		sourceColumn: FonteDescricao

		annotation SummarizationSetBy = Automatic

	partition dMercadoria = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoDados & "dMercadoria.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    SemVazios = Table.TransformColumns(Cabecalhos, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"CodMercadoria", type text}, {"Mercadoria", type text}, {"DescricaoSH4", type text}, {"CapituloSH2", type text}, {"DescricaoCapituloSH2", type text}, {"GrupoMercadoria", type text}, {"OrdemGrupo", Int64.Type}, {"FonteDescricao", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

